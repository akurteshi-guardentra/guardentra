rules_version = '2';
// EMERGENCY (P0, 2026-10-31) for the legacy named database
// ai-studio-guardentra-0c572bb5-3c5a-4cab-8963-fb0921691f79 in guardentra-7f582 ONLY.
// Owner decision 2026-10-31: lock the AI Studio prototype database. Blocks all client

# HISTORICAL EU-staging root — values must come from a fresh issue-bound packet.
# Do not substitute guardentra-staging or any other project from memory.
# #116 read-only cloud inventory must establish the intended target first.
#
# The placeholders below are intentionally invalid/incomplete for execution.
project_id                    = "REPLACE_FROM_APPROVED_ISSUE_PACKET"
backend_service_account_email = "REPLACE_FROM_APPROVED_ISSUE_PACKET"
execution_issue               = "REPLACE_WITH_#ISSUE"

region = "europe-west3"

# Keep mutation-capable modules disabled until the separately scoped packet explicitly
# authorizes them and records preflight + rollback/readback evidence.
enable_vpc       = false
enable_cloud_sql = false
vpc_network_id   = ""

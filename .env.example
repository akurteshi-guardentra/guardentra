# Local-first development. Copy to .env.local (gitignored) and fill values.
# Prefer 1Password Developer Environments to mount secrets — see docs/SECRETS.md.
# Firebase aliases: docs/ENVIRONMENTS.md (demo / dev / staging / prod).
# Never put Dashboard passwords or live secrets in chat or git.
APP_ENV=development

# Gemini — server /api/ai (and temporarily some client pages in non-prod)
GEMINI_API_KEY=

# Stripe — prefer restricted keys (rk_…); test mode for local/staging.
# Empty STRIPE_SECRET_KEY = checkout returns a clear "not configured" error, no fake success.
# Do not use Stripe Dashboard password here. Auth agents via MCP OAuth + API keys only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs surfaced on /pricing (client-exposed, hence VITE_ prefix — price IDs
# aren't secret). Create the Products/Prices in the Stripe Dashboard first (test mode),
# then paste the price_… IDs here. Leave blank and that plan's button shows an error
# instead of attempting a broken checkout — Gov tier is sales-contact only, no price ID.
VITE_STRIPE_PRICE_STARTER_MONTHLY=
VITE_STRIPE_PRICE_STARTER_ANNUAL=
VITE_STRIPE_PRICE_GROWTH_MONTHLY=
VITE_STRIPE_PRICE_GROWTH_ANNUAL=

# Optional: override listen port (Cloud Run / App Hosting set PORT automatically; local default 8080)
# PORT=8080
PORT=8080

# Firebase client — required for the web app (apiKey is no longer committed).
# Get values from Firebase Console → Project settings → Your apps (Web).
# Demo project identifiers are in firebase-applet-config.json; only the Web API key must be local.
VITE_FIREBASE_API_KEY=
# Optional overrides (defaults come from firebase-applet-config.json demo identifiers):
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_FIRESTORE_DATABASE_ID=
